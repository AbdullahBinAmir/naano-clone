# Copy to .env.local and fill in from Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase service-role key. Never prefix with NEXT_PUBLIC_. Used ONLY by
# the verified Safepay webhook/redirect settlement and the seed script; it bypasses RLS.
SUPABASE_SECRET_KEY=

# Safepay (https://getsafepay.com) — server-only. Use sandbox keys until go-live.
SAFEPAY_ENV=sandbox            # sandbox | production
SAFEPAY_API_KEY=               # public client key
SAFEPAY_SECRET_KEY=            # merchant secret key
SAFEPAY_WEBHOOK_SECRET=        # shared secret from the Safepay webhook settings

# Public origin of the deployed site (sitemap, robots.txt, social previews).
# On Vercel this falls back to the production hostname automatically.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
